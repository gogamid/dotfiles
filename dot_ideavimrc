" Minimal IdeaVim config for JetBrains IDEs.
" IdeaVim is enabled by the bundled plugin; this file customizes its behavior.
" Docs: https://github.com/JetBrains/ideavim

let mapleader = " "

" ---------- Editing ----------
set expandtab
set tabstop=2
set shiftwidth=2
set autoindent
set smartindent
set breakindent

" ---------- Search ----------
set incsearch
set ignorecase
set smartcase

" ---------- Display ----------
set number
set relativenumber
set scrolloff=8
set colorcolumn=80
set nowrap
set showmode

" ---------- Behavior ----------
set timeoutlen=1000
set clipboard=unnamed,unnamedplus

" ---------- NERDTree (built-in, backed by the Project tool window) ----------
set NERDTree
nnoremap <leader>e :NERDTree<CR>

" ---------- Reload this file ----------
" <Action> maps must use the recursive form (nmap); they do not work with nnoremap.
nmap <leader><leader> <Action>(IdeaVim.ReloadVimRc.reload)

" ---------- Common JetBrains actions ----------
nmap <leader>ff <Action>(GotoFile)
nmap <leader>ft <Action>(Terminal.OpenInTerminal)
