" Minimal IdeaVim config for JetBrains IDEs.
" IdeaVim is enabled by the bundled plugin; this file customizes its behavior.
" Docs: https://github.com/JetBrains/ideavim

let mapleader = " "

" ---------- Editing ----------
set expandtab
set tabstop=2
set shiftwidth=2
set autoindent
set smartindent
set breakindent

" ---------- Search ----------
set incsearch
set ignorecase
set smartcase

" ---------- Display ----------
set number
set relativenumber
set scrolloff=8
set colorcolumn=80
set nowrap
set showmode

" ---------- Behavior ----------
set timeoutlen=1000
set clipboard=unnamed,unnamedplus

" ---------- NERDTree (built-in, backed by the Project tool window) ----------
set NERDTree
nnoremap <leader>e :NERDTree<CR>

" ---------- Reload this file ----------
" <Action> maps must use the recursive form (nmap); they do not work with nnoremap.
nmap <leader><leader> <Action>(IdeaVim.ReloadVimRc.reload)

" ---------- Common JetBrains actions ----------
" Save the current file (Ctrl+S in normal mode)
nmap <C-s> <Action>(SaveDocument)
nmap <leader>ff <Action>(GotoFile)
nmap <leader>ft <Action>(Terminal.OpenInTerminal)
" 'Find Action' — searchable view of all IDE commands/actions
nmap <leader>ca <Action>(GotoAction)
" Zoom the whole IDE (tracked via IdeaVim Track Action Ids)
nmap <leader>zi <Action>(ZoomInIdeAction)
nmap <leader>zo <Action>(ZoomOutIdeAction)
nmap <leader>zr <Action>(ResetIdeScaleAction)
" DataGrip: choose data source / schema (SQL-console context actions)
nmap <leader>ss <Action>(Console.Jdbc.ChooseDataSource)
nmap <leader>su <Action>(Console.Jdbc.ChooseSchema)
" Fuzzy-search open/recent files (closest to Vim 'open buffers')
nmap <leader>, <Action>(RecentFiles)
" DataGrip: Esc in normal mode hides the active tool window (Shift+Esc equivalent)
nmap <Esc> <Action>(HideActiveWindow)
