" Minimal IdeaVim config for JetBrains IDEs.
" IdeaVim is enabled by the bundled plugin; this file customizes its behavior.
" Docs: https://github.com/JetBrains/ideavim

let mapleader = " "

" ---------- Editing ----------
set expandtab
set tabstop=2
set shiftwidth=2
set autoindent
set smartindent
set breakindent

" ---------- Search ----------
set incsearch
set ignorecase
set smartcase

" ---------- Display ----------
set number
set relativenumber
set scrolloff=8
set colorcolumn=80
set nowrap
set showmode

" ---------- Behavior ----------
set timeoutlen=1000
set clipboard=unnamed,unnamedplus

" ---------- NERDTree (built-in, backed by the Project tool window) ----------
set NERDTree
nnoremap <leader>e :NERDTree<CR>

" ---------- Reload this file ----------
" <Action> maps must use the recursive form (nmap); they do not work with nnoremap.
nmap <leader><leader> <Action>(IdeaVim.ReloadVimRc.reload)

" ---------- Common JetBrains actions ----------
" Save the current file (Ctrl+S in normal mode)
nmap <C-s> <Action>(SaveDocument)
nmap <leader>ff <Action>(GotoFile)
" 'Find Action' — searchable view of all IDE commands/actions
map <leader>ca <Action>(GotoAction)
" Zoom the whole IDE (tracked via IdeaVim Track Action Ids)
nmap <leader>zi <Action>(EditorIncreaseFontSize)
nmap <leader>zo <Action>(EditorDecreaseFontSize)
nmap <leader>zr <Action>(EditorResetFontSize)
nmap <leader>zz <Action>(ToggleZenMode)
" DataGrip: choose data source / schema (SQL-console context actions)
nmap <leader>ss <Action>(Console.Jdbc.ChooseDataSource)
nmap <leader>su <Action>(Console.Jdbc.ChooseSchema)
nmap <leader>sp <Action>(Console.Jdbc.ExplainPlan)
" Fuzzy-search open/recent files (closest to Vim 'open buffers')
nmap <leader>, <Action>(RecentFiles)
" DataGrip: Esc in normal mode hides the active tool window (Shift+Esc equivalent)
nmap <Esc> <Action>(HideActiveWindow)

" ---------- Window navigation (Ctrl+h/j/k/l) ----------
" Must route the Ctrl keys to vim first (sethandler ... a:vim) or the IDE
" intercepts them. Then map to vim's native <C-w> moves.
sethandler <c-h> a:vim
sethandler <c-j> a:vim
sethandler <c-k> a:vim
sethandler <c-l> a:vim
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
" Leader | = split vertical (right), Leader - = split horizontal (below)
nmap <leader><Bar> <Action>(SplitVertically)
nmap <leader>- <Action>(SplitHorizontally)
" Leader wd = close current editor/split (window delete)
nmap <leader>wd <Action>(CloseContent)
