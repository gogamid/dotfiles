#!/bin/zsh
#
# system-update - daily maintenance: Homebrew, Neovim plugins, pi.
#
# All tasks run in parallel and are best-effort: a missing binary logs SKIP
# and the run continues. A failing task does not abort the others.
#
# The log file is truncated on every run.
#
# Usage:
#   system-update              # run every task
#   system-update <task> ...   # run only the named task(s)
#
# PATH comes from ~/.zshenv, which zsh sources for every invocation,
# interactive or not. Do not run this script with `zsh -f`.

set -eu
set -o pipefail

# --- Config ------------------------------------------------------------------

readonly LOG_FILE="/tmp/system-update.log"
readonly LOCK_DIR="/tmp/system-updater.lock"

# Keeps Homebrew non-interactive and quiet. Applied per command via env, so it
# never leaks into other tasks.
readonly -a BREW_ENV=(
  CI=1
  HOMEBREW_NO_ANALYTICS=1
  HOMEBREW_NO_ENV_HINTS=1
  HOMEBREW_NO_INSTALL_CLEANUP=1
  HOMEBREW_NO_AUTO_UPDATE=1
  HOMEBREW_NO_INTERACTIVE=1
  NONINTERACTIVE=1
)

# Tasks run when no task name is given. Order is cosmetic (they run in
# parallel), it only affects the order tasks are launched in.
readonly -a DEFAULT_TASKS=(homebrew neovim-plugins pi-update)

# Task result codes.
readonly RC_DONE=0
readonly RC_SKIP=10
readonly RC_UNKNOWN=2

# --- Helpers -----------------------------------------------------------------

log() {
  print -- "$*"
  print -- "$*" >> "$LOG_FILE"
}

# Format a duration in seconds as "42s" or "2m 5s".
fmt_duration() {
  local s=$1
  if (( s >= 60 )); then
    print -n -- "$(( s / 60 ))m $(( s % 60 ))s"
  else
    print -n -- "${s}s"
  fi
}

# Indent every line of a multi-line string by N spaces.
indent() {
  local pad line
  pad=$(printf "%$1s" "")
  for line in ${(f)2}; do
    print -- "$pad$line"
  done
}

setup_log() {
  mkdir -p "${LOG_FILE:h}"
  : > "$LOG_FILE"
}

acquire_lock() {
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    print -- "Another update is already running (lock: $LOCK_DIR)" >&2
    exit 0
  fi
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
}

# --- Tasks -------------------------------------------------------------------

# Upgrade everything outdated, one package at a time so a failure can be
# attributed and reported per package. Only changed packages are printed.
update_homebrew() {
  local pkg out rc=0
  local -a pkgs

  if ! out=$(env "${BREW_ENV[@]}" brew update --force 2>&1); then
    print -- "    ❌ brew update"
    indent 8 "$out"
    rc=1
  fi

  # Formulae.
  pkgs=(${(f)"$(brew outdated --formula --quiet 2>/dev/null)"})
  for pkg in "${pkgs[@]}"; do
    if out=$(env "${BREW_ENV[@]}" brew upgrade --formula "$pkg" </dev/null 2>&1); then
      print -- "    ✅ $pkg"
    else
      print -- "    ❌ $pkg"
      indent 8 "$out"
      rc=1
    fi
  done

  # Casks, including self-updating ones (--greedy). Casks with a pkg artifact
  # run the vendor installer as root and would ask for a password, so they are
  # skipped and left for a manual update.
  pkgs=(${(f)"$(brew outdated --cask --greedy --quiet 2>/dev/null)"})
  for pkg in "${pkgs[@]}"; do
    if brew info --json=v2 --cask "$pkg" 2>/dev/null | grep -q '"pkg"'; then
      print -- "    ⚠️ $pkg (needs admin password)"
      continue
    fi

    if out=$(env "${BREW_ENV[@]}" brew upgrade --cask "$pkg" </dev/null 2>&1); then
      print -- "    ✅ $pkg"
    else
      print -- "    ❌ $pkg"
      indent 8 "$out"
      rc=1
    fi
  done

  return $rc
}

update_neovim() {
  local out rc=0
  out=$(nvim --headless "+Lazy! sync" +qa 2>&1) || rc=$?

  # Lazy is chatty even when nothing changed, so only dump its output when the
  # sync actually failed.
  if (( rc != 0 )); then
    out=$(print -r -- "$out" | perl -pe 's/\e\[[0-9;]*m//g')
    indent 8 "$out"
  fi

  return $rc
}

update_pi() {
  local out rc=0
  out=$(pi update --all --no-approve </dev/null 2>&1) || rc=$?
  if (( rc != 0 )); then
    indent 8 "$out"
  fi
  return $rc
}

# --- Runner ------------------------------------------------------------------

# Run one task in the current (sub)shell. Returns RC_DONE, RC_SKIP, or the
# handler's exit code. Handlers are found through PATH.
#
# Status lines are written to the terminal and appended to the log.
# Handler output is captured and printed as one
# block under the task, so parallel tasks never interleave.
run_task() {
  local name=$1 handler=$2 bin=$3 start=$SECONDS rc=0 out block=""

  if ! command -v "$bin" >/dev/null 2>&1; then
    log "⚠️  $name ($bin not found)"
    return $RC_SKIP
  fi

  log "▶️  $name"

  out=$("$handler" 2>&1) || rc=$?

  [[ -n $out ]] && block="$out"$'\n'
  if (( rc == 0 )); then
    block+="✅  $name ($(fmt_duration $(( SECONDS - start ))))"
  else
    block+="❌  $name ($(fmt_duration $(( SECONDS - start ))), exit $rc)"
  fi

  log "$block"
  return $rc
}

# Map a task name to its handler and the binary it needs.
# Add a task here + a function above + the name in DEFAULT_TASKS.
dispatch() {
  case $1 in
    homebrew)       run_task "$1" update_homebrew brew ;;
    neovim-plugins) run_task "$1" update_neovim   nvim ;;
    pi-update)      run_task "$1" update_pi       pi   ;;
    *)              print -- "Unknown task: $1" >&2; return $RC_UNKNOWN ;;
  esac
}

# --- Main --------------------------------------------------------------------

main() {
  local name rc
  local -a tasks pids
  typeset -i completed=0 skipped=0 failures=0

  if (( $# > 0 )); then
    tasks=("$@")
  else
    tasks=("${DEFAULT_TASKS[@]}")
  fi

  # Validate everything up front so a typo launches nothing.
  for name in "${tasks[@]}"; do
    if (( ! ${DEFAULT_TASKS[(Ie)$name]} )); then
      print -- "Unknown task: $name" >&2
      print -- "Valid tasks: ${(j:, :)DEFAULT_TASKS}" >&2
      return $RC_UNKNOWN
    fi
  done

  setup_log

  log "system update started (${#tasks} task(s): ${(j:, :)tasks})"

  for name in "${tasks[@]}"; do
    ( dispatch "$name" ) &
    pids+=($!)
  done

  for pid in "${pids[@]}"; do
    rc=0
    wait "$pid" || rc=$?
    case $rc in
      "$RC_DONE") (( completed += 1 )) ;;
      "$RC_SKIP") (( skipped += 1 )) ;;
      *)          (( failures += 1 )) ;;
    esac
  done

  log "system update finished: ✅ $completed · ⚠️ $skipped · ❌ $failures"
  log "log: $LOG_FILE"

  if (( failures > 0 )); then
    return 1
  fi
  return 0
}

acquire_lock
main "$@"
