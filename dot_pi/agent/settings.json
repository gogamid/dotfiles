{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash-vision-exp",
  "hideThinkingBlock": true,
  "npmCommand": ["bun"],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents",
    "npm:pi-auto-theme-switcher",
    "npm:pi-herdr-cursor-focus",
    "npm:pi-simplify",
    "git:github.com/gogamid/pi-diff",
    "git:github.com/gogamid/context-mode"
  ],
  "editorPaddingX": 3,
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "user-only",
